[Desktop Entry]
Type=Application
Version=1.0
Name=PlanaLyrics
Name[zh_CN]=PlanaLyrics 歌词
GenericName=Desktop lyrics overlay
GenericName[zh_CN]=桌面歌词
Comment=Lyrics overlay that follows the music player
Comment[zh_CN]=跟随音乐播放器的桌面歌词覆盖层
Exec=@EXEC@
Icon=planalyrics
Terminal=false
Categories=AudioVideo;Audio;Player;
Keywords=lyrics;lrc;歌词;桌面歌词;
StartupNotify=false
StartupWMClass=planalyrics
Actions=RestoreDefaults;

[Desktop Action RestoreDefaults]
Name=Restore default settings
Name[zh_CN]=恢复默认设置
Exec=@EXEC@ --restore-defaults
